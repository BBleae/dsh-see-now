{
  "name": "dsh-see-now",
  "version": "0.0.2",
  "description": "Let DSH watch a live screen or camera feed: score frames by how much the picture changes, pack the important ones into a 4x4 sheet, and push it into the session.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./pack": "./src/pack.js",
    "./png": "./src/png.js",
    "./pipeline": "./src/pipeline.js",
    "./capture": "./src/capture.js",
    "./chat": "./src/chat.js",
    "./speech": "./src/speech.js",
    "./voice": "./src/voice.js",
    "./interject": "./src/interject.js",
    "./window": "./src/window.js",
    "./runner": "./src/runner.js",
    "./loop": "./src/loop.js",
    "./timer": "./src/timer.js",
    "./tool-spec": "./src/tool-spec.js"
  },
  "files": [
    "src",
    "scripts",
    "examples",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "debug:live": "node debug/live.mjs",
    "install-dev": "node scripts/install-dev.mjs",
    "check": "node scripts/install-dev.mjs --check",
    "sync:window": "node scripts/sync-window.mjs",
    "check:window": "node scripts/sync-window.mjs --check",
    "prepack": "node scripts/sync-window.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true
}
